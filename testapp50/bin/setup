#!/usr/bin/env ruby
require 'pathname'
require 'fileutils'
include FileUtils

APP_ROOT  = Pathname.new File.expand_path('../../', __FILE__)
REPO_ROOT = APP_ROOT.parent
PGDATA    = REPO_ROOT.join('postgres/data')
PGLOG     = REPO_ROOT.join('postgres/log')
PGPORT    = 5433

def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

def pg_ctl(*args)
  system!('pg_ctl', '-D', PGDATA.to_s, '-l', PGLOG.to_s, *args)
end

def psql!(sql)
  system!('psql', '-p', PGPORT.to_s, '-d', 'postgres', '-c', sql)
end

def role_exists?(name)
  `psql -p #{PGPORT} -d postgres -tAc "SELECT 1 FROM pg_roles WHERE rolname='#{name}'"`.strip == '1'
end

chdir APP_ROOT do
  puts '== Installing dependencies =='
  system! 'gem install bundler --conservative'
  system('bundle check') || system!('bundle install')

  puts "\n== Initialising PostgreSQL =="
  unless PGDATA.exist?
    mkdir_p PGDATA.parent
    system! 'initdb', '-D', PGDATA.to_s, '--no-locale', '--encoding=UTF8'
    File.open(PGDATA.join('postgresql.conf'), 'a') do |f|
      f.puts "\nport = #{PGPORT}"
    end
  end

  puts "\n== Starting PostgreSQL =="
  unless system('pg_ctl', '-D', PGDATA.to_s, 'status', out: File::NULL, err: File::NULL)
    pg_ctl('start')
    sleep 1
  end

  puts "\n== Creating PostgreSQL roles =="
  unless role_exists?('master')
    puts 'Creating role: master'
    psql! 'CREATE ROLE master LOGIN CREATEDB'
  else
    puts 'Role master already exists'
    psql! 'ALTER ROLE master CREATEDB'
  end

  unless role_exists?('slave')
    puts 'Creating role: slave'
    psql! 'CREATE ROLE slave LOGIN'
  else
    puts 'Role slave already exists'
  end

  puts "\n== Preparing database =="
  system! 'bin/rails db:create'
  system! 'bin/rails db:schema:load'

  puts "\n== Granting slave role read-only permissions =="
  %w[postamt_test postamt].each do |db|
    psql2 = ->(sql) { system!('psql', '-p', PGPORT.to_s, '-d', db, '-c', sql) }
    psql2.call('GRANT SELECT ON ALL TABLES IN SCHEMA public TO slave')
    psql2.call('ALTER DEFAULT PRIVILEGES FOR ROLE master IN SCHEMA public GRANT SELECT ON TABLES TO slave')
  end

  puts "\n== Removing old logs and tempfiles =="
  system! 'bin/rails log:clear tmp:clear'

  puts "\n== Done! Run tests with: bin/rails test =="
end
